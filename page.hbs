{{!< default}} {{#page}} <article id="post" data-id="{{id}}"
    class="{{#if @page.show_title_and_feature_image}}px-4 md:px-16{{else}}py-12 md:py-28 px-4 md:px-16{{/if}} max-w-4xl my-12 pb-12 md:pb-16 mx-auto w-full">

    {{#if @page.show_title_and_feature_image}}
    <!-- Header Section -->
    <header class="mb-10 pb-8 py-10 text-center">
        <h1 class="text-3xl md:text-6xl font-extrabold tracking-tight leading-tight text-foreground mb-6">
            {{title}}
        </h1>
        {{#if excerpt}}
        <p class="text-sm md:text-lg font-medium tracking-tight leading-tight text-muted-foreground mb-6">
            {{excerpt}}
        </p>
        {{/if}}
    </header>
    {{/if}}

    <!-- Article Content -->
    <div
        class="prose prose-invert max-w-none prose-headings:font-bold prose-headings:text-foreground prose-a:text-foreground prose-a:underline hover:prose-a:text-muted-foreground prose-pre:bg-card prose-pre:border prose-pre:border-border prose-img:rounded-xl">
        {{content}}
    </div>

    </article>
    {{/page}}