{{!< default}} {{#post}} <article class="pt-12 md:pt-28 px-4 max-w-6xl md:px-8 mx-auto w-full">

    <!-- Header Section (Wider width) -->
    <header class="mb-10 pb-8 py-10 text-center max-w-6xl mx-auto">
        <h1 class="text-3xl md:text-6xl font-extrabold tracking-tight leading-tight text-foreground mb-6">
            {{title}}
        </h1>
        <p
            class="text-sm md:text-lg font-medium tracking-tight leading-tight text-muted-foreground mb-6 max-w-4xl mx-auto">
            {{excerpt}}
        </p>

        <!-- Author, Date, Reading Time Header Metadata -->
        <div class="flex flex-wrap items-center justify-center gap-4 text-xs text-muted-foreground">
            <div class="flex flex-wrap items-center gap-3">
                {{#foreach authors}}
                <div class="flex items-center gap-2">
                    {{#if profile_image}}
                    <img src="{{img_url profile_image size=" xs"}}" alt="{{name}}"
                        class="w-7 h-7 rounded-full border border-border object-cover" />
                    {{else}}
                    <div
                        class="w-7 h-7 rounded-full border border-border bg-secondary flex items-center justify-center text-[10px] font-bold text-foreground">
                        {{name}}
                    </div>
                    {{/if}}
                    <a href="{{url}}"
                        class="font-medium text-foreground hover:text-muted-foreground transition-colors">{{name}}</a>
                </div>
                {{/foreach}}

                <span>&middot;</span>

                <time datetime="{{date published_at format=" YYYY-MM-DD"}}">{{date published_at format="MMMM D,
                    YYYY"}}</time>

                <span>&middot;</span>

                <span>{{reading_time}}</span>
                <span>&middot;</span>
                {{#primary_tag}}
                <span>
                    <a href="{{url}}"
                        class="flex items-center gap-2 text-xs text-foreground hover:text-muted-foreground transition-colors p-2">
                        {{> "components/icon" name="tag" class="w-4 h-4" ariaLabel="Tag {{name}}"}} {{name}}
                    </a>
                </span>
                {{/primary_tag}}
                {{#has visibility="public"}}
                <span>&middot;</span>
                <span>
                    <a href="/#/share"
                        class="flex items-center gap-2 text-xs text-foreground hover:text-muted-foreground transition-colors p-2">
                        {{> "components/icon" name="share-2" class="w-4 h-4" ariaLabel="Share {{title}}"}}
                        Share
                    </a>
                </span>
                {{/has}}
            </div>
        </div>
    </header>


    <!-- Article Content (max-w-3xl) -->
    <div class="max-w-3xl mx-auto w-full">
        <div
            class="prose prose-invert max-w-none prose-headings:font-bold prose-headings:text-foreground prose-a:text-foreground prose-a:underline hover:prose-a:text-muted-foreground prose-pre:bg-card prose-pre:border prose-pre:border-border prose-img:rounded-xl">
            {{content}}
        </div>

        {{> "show-comment"}}
    </div>
    </article>

    {{#get "posts" include="tags,authors" filter="authors:{{primary_author.slug}}+id:-{{id}}" limit="3" as
    |related_posts|}}
    {{#if related_posts}}
    <section class="max-w-7xl mx-auto px-4 md:px-8 py-12 border-t border-border/60 mt-16">
        {{> "post-grid" posts=related_posts title=(concat "More from " ../primary_author.name)}}
    </section>
    {{/if}}
    {{/get}}

    {{/post}}