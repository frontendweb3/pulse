{{!-- Add the script and css to theme --}}

{{!-- Preload CSS to start download early --}}
<link rel="preload" href="{{asset 'dist/css/main.css'}}" as="style"
    onload="this.onload=null;this.rel='stylesheet';document.documentElement.classList.remove('no-js')" />
<script defer src="{{asset 'dist/js/main.js'}}"></script>

{{#is "post, page"}}
{{!-- Highlight code and config the copy code button on code block --}}
<script type="module" defer src="{{asset 'dist/js/post.js'}}"></script>
<link rel="preload" href="{{asset 'dist/css/post.css'}}" as="style" onload="this.onload=null;this.rel='stylesheet'" />
{{/is}}