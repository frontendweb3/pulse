<!-- Header Navbar -->
<header x-data="{ mobileMenuOpen: false }"
    class="sticky top-0 z-50 w-full border-b border-border/60 bg-background/40 backdrop-blur-md px-4 md:px-8">
    <nav class="flex max-w-10xl items-center justify-between mx-auto py-4 md:py-6">
        <!-- Left: Logo & Main Navigation -->
        <div class="flex items-center gap-8 md:gap-12">
            <a class="font-bold text-xl md:text-2xl tracking-tight text-foreground hover:opacity-90 transition-opacity flex items-center gap-3"
                href="{{@site.url}}">
                {{#if @site.logo}}
                <img src="{{@site.logo}}" alt="{{@site.title}}" class="h-8 md:h-9 w-auto" />
                <span>{{@site.title}}</span>
                {{else}}
                {{@site.title}}
                {{/if}}
            </a>
            <!-- Desktop Navigation Links -->
            <div class="hidden md:flex items-center gap-8">
                {{#if @site.navigation}}
                {{navigation}}
                {{/if}}
            </div>
        </div>

        <!-- Right: Actions & Call to Action -->
        <div class="flex items-center gap-3 sm:gap-4">
            <!-- Search Button -->
            <button data-ghost-search id="search-toggle" type="button" aria-label="Search posts"
                class="group flex items-center justify-center w-10 h-10 rounded-lg text-muted-foreground hover:text-foreground hover:bg-secondary/60 transition-all duration-200 hover:scale-105 active:scale-95">
                {{> "components/icon" name="search" class="w-5 h-5 transition-transform duration-200
                group-hover:rotate-12 group-hover:scale-110"}}
            </button>

            {{#if @member}}
            <!-- Account Button for Logged In Members -->
            <a href="#/portal/account" data-portal="account"
                class="group relative hidden sm:inline-flex items-center gap-2 bg-secondary border border-border text-foreground hover:bg-secondary/90 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/10 hover:ring-2 hover:ring-primary/30 hover:-translate-y-0.5 hover:scale-105 active:scale-95 text-sm font-semibold px-4 py-2 rounded-full transition-all duration-300 overflow-hidden shadow-sm">
                <span
                    class="absolute inset-0 -translate-x-full group-hover:translate-x-full bg-linear-to-r from-transparent via-foreground/10 to-transparent transition-transform duration-700 ease-in-out pointer-events-none"></span>
                {{> "components/icon" name="user-round" class="w-4 h-4 transition-all duration-300 group-hover:scale-125
                group-hover:rotate-12 group-hover:text-primary"}}
                <span class="relative z-10">Account</span>
            </a>

            <!-- Sign out Button (Desktop) -->
            <button data-members-signout type="button"
                class="group hidden xl:inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 px-3 py-2 rounded-full hover:bg-secondary/50">
                {{> "components/icon" name="log-out" class="w-4 h-4 transition-transform duration-200
                group-hover:-translate-x-0.5"}}
                <span>Sign out</span>
            </button>
            {{else}}
            <!-- Sign in Link (Desktop) -->
            <a href="#/portal/signin" data-portal="signin"
                class="group hidden xl:inline-flex items-center gap-2 text-sm md:text-base font-medium text-foreground hover:text-foreground/80 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 px-3 py-1.5 rounded-full hover:bg-secondary/40">
                {{> "components/icon" name="log-in" class="w-4 h-4 transition-transform duration-200
                group-hover:translate-x-0.5"}}
                <span>Sign in</span>
            </a>

            <!-- Sign up Button (Desktop) -->
            <a href="#/portal/signup" data-portal="signup"
                class="group hidden sm:inline-flex items-center gap-2 bg-primary text-primary-foreground hover:bg-primary/90 hover:shadow-md hover:shadow-primary/25 hover:-translate-y-0.5 active:translate-y-0 active:scale-95 text-sm md:text-base font-bold px-5 py-2.5 md:px-6 md:py-3 rounded-full transition-all duration-200 shadow-sm">
                {{> "components/icon" name="user-plus" class="w-4 h-4 transition-transform duration-200
                group-hover:scale-110 group-hover:rotate-6"}}
                <span>Sign up</span>
            </a>
            {{/if}}

            <!-- Mobile Menu Toggle Button -->
            <button @click="mobileMenuOpen = !mobileMenuOpen" type="button" aria-label="Toggle navigation menu"
                class="group md:hidden flex items-center justify-center w-10 h-10 rounded-lg text-muted-foreground hover:text-foreground hover:bg-secondary/60 transition-all duration-200 hover:scale-105 active:scale-95">
                <!-- Hamburger Icon -->
                <svg x-show="!mobileMenuOpen" class="w-6 h-6 transition-transform duration-200 group-hover:scale-105"
                    fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <!-- Close Icon -->
                <svg x-show="mobileMenuOpen" x-cloak
                    class="w-6 h-6 transition-transform duration-200 group-hover:rotate-90" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </nav>

    <!-- Mobile Dropdown Menu -->
    <div x-show="mobileMenuOpen" x-collapse.duration.200ms class="md:hidden border-t border-border/60 bg-background">
        <div class="py-4 px-4 flex flex-col gap-4">

            <!-- Horizontal Scrollable Navigation (scroll-x smooth) -->
            {{#if @site.navigation}}
            <div
                class="overflow-x-auto scroll-smooth [webkit-overflow-scrolling:touch] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden whitespace-nowrap py-1 [&_ul]:flex [&_ul]:flex-row [&_ul]:flex-nowrap [&_ul]:gap-6 [&_li]:shrink-0">
                {{navigation}}
            </div>
            {{/if}}

            <!-- Mobile Auth Buttons -->
            <div class="flex flex-col gap-2.5 pt-3 border-t border-border/40">
                {{#if @member}}
                <a href="#/portal/account" data-portal="account"
                    class="group relative flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-full bg-secondary border border-border text-foreground text-sm font-semibold hover:bg-secondary/90 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/10 hover:ring-2 hover:ring-primary/30 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] transition-all duration-300 overflow-hidden">
                    <span
                        class="absolute inset-0 -translate-x-full group-hover:translate-x-full bg-linear-to-r from-transparent via-foreground/10 to-transparent transition-transform duration-700 ease-in-out pointer-events-none"></span>
                    {{> "components/icon" name="user-round" class="w-4 h-4 transition-all duration-300
                    group-hover:scale-125 group-hover:rotate-12 group-hover:text-primary"}}
                    <span class="relative z-10">Account</span>
                </a>
                <button data-members-signout type="button"
                    class="group flex items-center justify-center gap-1.5 text-xs text-muted-foreground hover:text-foreground hover:-translate-y-0.5 active:translate-y-0 py-1.5 rounded-full hover:bg-secondary/40 text-center transition-all duration-200">
                    {{> "components/icon" name="log-out" class="w-3.5 h-3.5 transition-transform duration-200
                    group-hover:-translate-x-0.5"}}
                    <span>Sign out</span>
                </button>
                {{else}}
                <a href="#/portal/signin" data-portal="signin"
                    class="group flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-full border border-border text-foreground text-sm font-medium hover:bg-secondary hover:shadow-sm hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] transition-all duration-200">
                    {{> "components/icon" name="log-in" class="w-4 h-4 transition-transform duration-200
                    group-hover:translate-x-0.5"}}
                    <span>Sign in</span>
                </a>
                <a href="#/portal/signup" data-portal="signup"
                    class="group flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-full bg-primary text-primary-foreground text-sm font-bold hover:bg-primary/90 hover:shadow-md hover:shadow-primary/25 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] transition-all duration-200 shadow-sm">
                    {{> "components/icon" name="user-plus" class="w-4 h-4 transition-transform duration-200
                    group-hover:scale-110 group-hover:rotate-6"}}
                    <span>Sign up</span>
                </a>
                {{/if}}
            </div>
        </div>
    </div>
</header>