<article
    class="group flex flex-col h-full w-full cursor-pointer overflow-hidden p-4 bg-card border border-border/60 hover:border-primary/50 transition-all duration-300 shadow-xs hover:shadow-md">

    <!-- Media Header Container -->
    <a href="{{url}}" class="block w-full overflow-hidden aspect-[1.7/1] shrink-0 relative bg-slate-950">
        {{#if feature_image}}
        <img class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            srcset="{{img_url feature_image size=" s"}} 300w, {{img_url feature_image size="m" }} 600w, {{img_url
            feature_image size="l" }} 1000w" sizes="(max-width: 768px) 100vw, 50vw" src="{{img_url feature_image size="
            m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy" />
        {{/if}}

        <!-- Top-Right Pill Badge -->
        {{#featured}}
        <div class="absolute top-3 right-3 z-10">
            <span title="feature article"
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-600 text-white shadow-xs backdrop-blur-xs">
                <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
            </span>
        </div>
        {{/featured}}

    </a>

    <!-- Card Body Container -->
    <div class="pt-5 flex flex-col flex-1 justify-between bg-card">
        <!-- Title & Directional Arrow -->
        <div class="flex items-start justify-between gap-3">
            <a href="{{url}}" class="group-hover:text-primary transition-colors">
                <h2 class="text-base md:text-lg font-bold text-foreground tracking-tight leading-snug">
                    {{title}}
                </h2>
            </a>

            <a href="{{url}}" aria-label="Read {{title}}"
                class="shrink-0 mt-0.5 text-muted-foreground group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all">
                <i data-lucide="arrow-up-right" class="w-5 h-5"></i>
            </a>
        </div>

        <!-- Bottom Tag Category & Date Row -->
        <div
            class="flex items-center justify-between text-xs text-muted-foreground font-semibold mt-5 pt-4 border-t border-border/50">
            <div class="flex items-center gap-1.5 shrink-0">
                <span class="font-bold text-foreground/90">{{#primary_tag}}{{name}}{{/primary_tag}}</span>
                <span class="text-muted-foreground/60">&bull;</span>
                <span>{{reading_time minute="1 min read" minutes="% min read"}}</span>
            </div>
            <time datetime="{{date format=" YYYY-MM-DD"}}" class="shrink-0">
                {{date format="MMM D, YYYY"}}
            </time>
        </div>
    </div>
</article>