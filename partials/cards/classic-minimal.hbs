<article class="group flex flex-col h-full w-full cursor-pointer">
    {{#if feature_image}}
    <a href="{{url}}" class="block w-full overflow-hidden rounded-xs bg-card aspect-[1.6/1] shrink-0 relative">
        <img class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-110"
            srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w"
            sizes="(max-width: 768px) 100vw, 50vw"
            src="{{img_url feature_image size="m"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            loading="lazy" />
    </a>
    {{/if}}

    <div class="flex flex-col flex-1 justify-between gap-3 mt-4">
        <a href="{{url}}" class="group-hover:text-foreground/80 transition-colors">
            <h2 class="text-base md:text-lg font-semibold text-foreground tracking-tight leading-snug">
                {{title}}
            </h2>
        </a>

        <div class="flex items-center gap-2 text-xs text-muted-foreground font-medium mt-auto">
            <span>{{#primary_author}}{{name}}{{/primary_author}}</span>
            <span>&middot;</span>
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
            <span>&middot;</span>
            <span>{{reading_time minute="1 min read" minutes="% min read"}}</span>
        </div>
    </div>
</article>