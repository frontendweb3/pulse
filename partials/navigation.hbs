{{#if isSecondary}}
    <ul class="flex flex-wrap items-center gap-6 list-none p-0 m-0">
        {{#foreach navigation}}
            <li>
                <a href="{{url absolute="true"}}" class="text-sm text-muted-foreground hover:text-foreground transition-colors">{{label}}</a>
            </li>
        {{/foreach}}
    </ul>
{{else}}
    <ul class="flex items-center gap-8 list-none p-0 m-0">
        {{#foreach navigation}}
            <li>
                <a href="{{url absolute="true"}}" class="text-sm md:text-base font-medium text-muted-foreground hover:text-foreground transition-colors {{#if current}}text-foreground font-bold{{/if}}">{{label}}</a>
            </li>
        {{/foreach}}
    </ul>
{{/if}}


